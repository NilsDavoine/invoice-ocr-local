<?xml version="1.0" encoding="UTF-8"?>
<!-- Basic components (cbc) of the UBL 2.1 subset produced by invoice-ocr-local.
     Hand-written subset: element names, namespaces and order follow UBL 2.1 /
     EN 16931, but only header-level fields are declared and types are tightened. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2"
           xmlns="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2"
           elementFormDefault="qualified">

  <xs:simpleType name="NonEmpty">
    <xs:restriction base="xs:string"><xs:minLength value="1"/></xs:restriction>
  </xs:simpleType>

  <xs:complexType name="AmountType">
    <xs:simpleContent>
      <xs:extension base="TwoDecimals">
        <xs:attribute name="currencyID" use="required">
          <xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="[A-Z]{3}"/></xs:restriction></xs:simpleType>
        </xs:attribute>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:simpleType name="TwoDecimals">
    <xs:restriction base="xs:decimal"><xs:fractionDigits value="2"/></xs:restriction>
  </xs:simpleType>

  <xs:element name="CustomizationID" type="NonEmpty"/>
  <xs:element name="ID" type="NonEmpty"/>
  <xs:element name="IssueDate" type="xs:date"/>
  <xs:element name="DueDate" type="xs:date"/>
  <xs:element name="InvoiceTypeCode">
    <xs:simpleType><xs:restriction base="xs:string">
      <xs:enumeration value="380"/><!-- commercial invoice -->
      <xs:enumeration value="381"/><!-- credit note -->
    </xs:restriction></xs:simpleType>
  </xs:element>
  <!-- The extraction status is mandatory and machine-checkable: "TO_VERIFY" must
       carry at least one reason code. Subject code AAI = general information (UNCL 4451). -->
  <xs:element name="Note">
    <xs:simpleType><xs:restriction base="xs:string">
      <xs:pattern value="#AAI#STATUS=(OK|TO_VERIFY;[A-Z_]+(,[A-Z_]+)*)"/>
    </xs:restriction></xs:simpleType>
  </xs:element>
  <xs:element name="DocumentCurrencyCode">
    <xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="[A-Z]{3}"/></xs:restriction></xs:simpleType>
  </xs:element>
  <xs:element name="CompanyID" type="NonEmpty"/>
  <xs:element name="RegistrationName" type="NonEmpty"/>
  <xs:element name="Percent">
    <xs:simpleType><xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/><xs:maxInclusive value="100"/>
    </xs:restriction></xs:simpleType>
  </xs:element>
  <xs:element name="TaxAmount" type="AmountType"/>
  <xs:element name="TaxableAmount" type="AmountType"/>
  <xs:element name="LineExtensionAmount" type="AmountType"/>
  <xs:element name="TaxExclusiveAmount" type="AmountType"/>
  <xs:element name="TaxInclusiveAmount" type="AmountType"/>
  <xs:element name="PayableAmount" type="AmountType"/>
</xs:schema>
